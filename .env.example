# Copy to .env for running services on the HOST (docker services get
# their own overrides inside docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:29092
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_RUNNING
POSTGRES_DSN=postgresql+psycopg2://fraud:${POSTGRES_PASSWORD}@localhost:5433/fraud
MLFLOW_TRACKING_URI=http://localhost:5000
INFERENCE_URL=http://localhost:8000

MODEL_NAME=fraud_xgb
MODEL_STAGE=Production
MODEL_PATH=artifacts/models/fraud_xgb.joblib

# Decision engine thresholds
BLOCK_THRESHOLD=0.85
REVIEW_THRESHOLD=0.50
VELOCITY_RULE_MAX_TXNS_10MIN=5

# Replay producer
LABEL_DELAY_SECONDS=30
